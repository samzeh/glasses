# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
DATABASE_URL=postgresql://tsdbadmin:your-password@your-host:your-port/tsdb?sslmode=require

# Keep the original recording in TigerData as well as its transcript and summary.
VOICE_NOTES_STORE_AUDIO=true

# Optional overrides, only needed if a model name changes.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
